# Copy this file to .env and adjust. All values are optional.

# Web server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# The database: a PostgreSQL connection string. A Supabase project gives you
# one under Project Settings -> Database -> Connection string.
#
# On Vercel (or any serverless host), use the *pooled* connection string --
# host has "pooler.supabase.com" in it and the port is 6543 -- not the direct
# one on port 5432. A burst of traffic can spin up many function instances
# at once, each opening its own connections, and Postgres only allows a
# limited number; the pooled string routes through PgBouncer instead.
#
# For local development, point this at any Postgres you have running --
# `postgresql://user:password@localhost:5432/revision_engine` for one on
# your own machine, or just use your Supabase project's connection string
# there too (its free tier is fine for development).
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Cap on concurrent connections this process opens to Postgres. Keep this
# low on serverless -- each function instance gets its own pool.
DATABASE_POOL_MAX=5

# Branding shown in the header and page titles
APP_NAME=Revision Engine

# Sessions
SESSION_TTL_HOURS=12
# Set to true once you serve the site over HTTPS
COOKIE_SECURE=false

# Set to false to stop students registering themselves
# (administrators can still create accounts for them)
ALLOW_REGISTRATION=true

# Used only by `npm run seed` when it creates the first administrator
ADMIN_EMAIL=admin@revision.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# "Sign in with Google" -- leave blank to keep email/password only.
# Get this from https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add both
#   http://localhost:3000          (or whatever PORT you run with)
#   https://your-real-domain       (once you have one)
# under "Authorized JavaScript origins" -- no need to add a redirect URI,
# this app uses Google's newer token-based sign-in, not a redirect flow.
GOOGLE_CLIENT_ID=
