# Copy this file to .env and adjust. All values are optional.

# Web server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Where the SQLite file lives (relative paths resolve from the project root)
DATABASE_FILE=data/revision-engine.db

# Branding shown in the header and page titles
APP_NAME=Revision Engine

# Sessions
SESSION_TTL_HOURS=12
# Set to true once you serve the site over HTTPS
COOKIE_SECURE=false

# Set to false to stop students registering themselves
# (administrators can still create accounts for them)
ALLOW_REGISTRATION=true

# Used only by `npm run seed` when it creates the first administrator
ADMIN_EMAIL=admin@revision.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

NEXT_PUBLIC_SUPABASE_URL=https://zrpjfkoaodirbajvkwwp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_onUkm4bMI_nHoHNrpbQIog_3U2OkhwG



# "Sign in with Google" -- leave blank to keep email/password only.
# Get this from https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add both
#   http://localhost:3000          (or whatever PORT you run with)
#   https://your-real-domain       (once you have one)
# under "Authorized JavaScript origins" -- no need to add a redirect URI,
# this app uses Google's newer token-based sign-in, not a redirect flow.
GOOGLE_CLIENT_ID=
