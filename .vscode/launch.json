{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Revision Engine",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": { "NODE_ENV": "development" }
    },
    {
      "name": "Seed the database",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/seed.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
